 "sprechen_modell.mp3": [
  {
   "v": "de-DE-KatjaNeural",
   "t": "Guten Tag! Ich heiße Manoj, ich komme aus Indien und wohne seit einem Jahr in Aachen. Ich arbeite als Softwareentwickler. Am Wochenende gehe ich gern spazieren oder koche mit Freunden. Im Sommer möchte ich öfter mit dem Fahrrad fahren. Und du? Wie kommst du zur Arbeit, und was machst du in deiner Freizeit?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Ich fahre mit dem Bus zur Arbeit. In meiner Freizeit lese ich gern.",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Guten Tag! Ich möchte heute über das Thema „Umweltschutz im Alltag“ sprechen, weil das in Deutschland sehr wichtig ist. Ich trenne meinen Müll, fahre oft mit dem Fahrrad und kaufe Gemüse auf dem Markt. In Indien gibt es in vielen Städten noch kein gutes System für Mülltrennung, aber immer mehr Menschen interessieren sich dafür. Ein Vorteil von Umweltschutz ist, dass die Luft sauberer wird und die Natur geschützt wird. Ein Nachteil ist, dass umweltfreundliche Produkte oft teurer sind. Meiner Meinung nach kann jeder etwas tun, auch mit kleinen Schritten. Vielen Dank für Ihre Aufmerksamkeit.",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Danke für den Vortrag. Was machst du persönlich am meisten für die Umwelt?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Ich trenne den Müll und kaufe wenig Plastik.",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Hallo Tim! Wir wollen mit dem Deutschkurs einen Abschlussausflug machen. Wann sollen wir fahren?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Ich schlage einen Samstag im Mai vor, dann ist das Wetter schön. Was meinst du?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Gute Idee. Und wohin? Ich würde gern an den Rursee fahren.",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Der Rursee ist schön. Wir könnten wandern und danach grillen.",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Super. Wie kommen wir dorthin? Mit dem Zug?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Ja, mit dem Zug ist es billiger und umweltfreundlicher. Ich suche eine Gruppenkarte heraus.",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Und wer bringt das Essen mit?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Jeder bringt etwas mit, und für die Getränke sammeln wir fünf Euro pro Person.",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Einverstanden. Dann haben wir alles besprochen.",
   "p": 1.2,
   "r": "-10%"
  }
 ]
