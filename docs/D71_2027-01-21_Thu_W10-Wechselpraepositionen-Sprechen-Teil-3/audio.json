 "sprechen_modell.mp3": [
  {
   "v": "de-DE-KatjaNeural",
   "t": "Hallo Tim! Wir wollen ja ein Hausfest für die ganze Nachbarschaft organisieren. Wann sollen wir es machen?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Ich schlage vor, dass wir es am ersten Samstag im Mai feiern. Dann ist das Wetter hoffentlich schön. Was hältst du davon?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Gute Idee. Und wo feiern wir? Im Hof oder im Gemeinschaftsraum?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Ich würde den Hof vorschlagen. Wir können die Tische und Stühle in den Hof stellen. Bei Regen ziehen wir in den Gemeinschaftsraum um.",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Einverstanden. Wer kümmert sich um das Essen und die Getränke?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Jeder Nachbar bringt etwas mit, zum Beispiel einen Salat oder einen Kuchen. Ich kann Getränke besorgen.",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Das gefällt mir. Und wen laden wir ein? Auch die Familie vom Hausmeister?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Natürlich. Ich hänge morgen eine Einladung ins Treppenhaus. Kannst du die Musik organisieren?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Gern, ich bringe Lautsprecher mit. Wir müssen nur um zweiundzwanzig Uhr aufhören, wegen der Ruhezeit.",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Stimmt. Haben wir alles besprochen? Dann machen wir das so.",
   "p": 1.2,
   "r": "-10%"
  }
 ]
}