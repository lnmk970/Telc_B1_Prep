 "sprechen_modell.mp3": [
  {
   "v": "de-DE-KatjaNeural",
   "t": "Guten Tag! Ich heiße Manoj und komme aus Indien. Ich arbeite als Softwareentwickler. Ich fahre mit dem Zug zur Arbeit. Ich habe einen Kollegen, der immer mit dem Rad fährt. Und Sie? Wie kommen Sie zur Arbeit?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "In meinem Text sagt Sabine: Sie fährt jeden Tag mit der Straßenbahn zur Arbeit. Das ist billig und umweltfreundlich, und sie kann unterwegs lesen. Aber manchmal ist die Bahn voll oder nicht pünktlich. Was steht in deinem Text?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "In meinem Text sagt Peter: Er braucht sein Auto, weil er auf dem Land wohnt. Der Bus fährt nur zweimal am Tag. Mit dem Auto ist er flexibel, aber das Benzin ist teuer, und Autos verschmutzen die Luft. Was meinst du?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Ich finde, dass beides richtig sein kann. In der Stadt sind die öffentlichen Verkehrsmittel besser, weil man keinen Parkplatz braucht. Auf dem Land braucht man oft ein Auto. Ich selbst fahre mit dem Zug, denn das ist bequem. Und du?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Ich fahre auch mit dem Zug.",
   "p": 1.2,
   "r": "-10%"
  }
 ]
