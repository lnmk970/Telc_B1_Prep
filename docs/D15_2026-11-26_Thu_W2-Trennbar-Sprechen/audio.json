 "sprechen_modell.mp3": [
  {
   "v": "de-DE-KatjaNeural",
   "t": "Guten Tag! Ich heiße Manoj und komme aus Indien. Ich bin Softwareentwickler. Morgens stehe ich um sieben Uhr auf, und meine Arbeit fängt um neun Uhr an. Und Sie? Wann stehen Sie auf?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "In meinem Text sagt Julia Hartmann: Sie arbeitet von zu Hause. Das findet sie praktisch, denn sie spart Zeit und muss nicht mit dem Auto fahren. Was steht in deinem Text?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "In meinem Text sagt Markus Schmidt: Er arbeitet lieber im Büro. Zu Hause kann er nicht gut arbeiten. Im Büro sieht er seine Kollegen. Was meinst du?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Ich finde beides gut. Ein Vorteil von zu Hause ist: Man spart Zeit. Ein Nachteil ist: Man sieht die Kollegen nicht. Ich arbeite zwei Tage zu Hause und drei Tage im Büro. Und du?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Ich arbeite auch gern im Büro, denn ich möchte mit meinen Kollegen sprechen.",
   "p": 1.2,
   "r": "-10%"
  }
 ]
