 "sprechen_modell.mp3": [
  {
   "v": "de-DE-KatjaNeural",
   "t": "Guten Tag! Ich heiße Manoj und komme aus Indien. Ich bin Softwareentwickler. Am Wochenende bin ich nach Köln gefahren und habe Freunde besucht. Und Sie? Was haben Sie am Wochenende gemacht?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "In meinem Text sagt Lisa Fischer: Sie wohnt gern in der Stadt, weil alles in der Nähe ist. Aber ihre Wohnung ist teuer, und es ist oft laut. Was steht in deinem Text?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "In meinem Text sagt Thomas Roth: Er wohnt auf dem Land in einem Haus mit Garten. Es ist ruhig und billig, aber er muss mit dem Auto zur Arbeit fahren. Was meinst du?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Ich finde beides gut. Ein Vorteil ist: In der Stadt ist alles in der Nähe. Ein Nachteil ist: Es ist laut und teuer. Ich wohne in der Stadt, und das gefällt mir. Wo möchtest du wohnen?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Ich möchte lieber auf dem Land wohnen, weil es dort ruhig ist.",
