 "sprechen_modell.mp3": [
  {
   "v": "de-DE-KatjaNeural",
   "t": "Guten Tag! Ich heiße Manoj und komme aus Indien. Ich arbeite als Softwareentwickler. Am Wochenende wollte ich schwimmen gehen, aber ich musste arbeiten. Und Sie? Was haben Sie am Wochenende gemacht?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "In meinem Text sagt Anna: Sie macht am liebsten Urlaub am Meer. Sie kann dort schwimmen und sich ausruhen. Aber im Sommer sind die Strände oft voll, und die Hotels sind teuer. Was steht in deinem Text?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "In meinem Text sagt Max: Er fährt lieber in die Berge. Er kann dort wandern, und die Luft ist frisch. Im Winter kann er auch Ski fahren. Aber die Fahrt dauert oft lange. Wohin fährst du lieber?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Ich finde, dass beides schön ist. Ein Vorteil vom Meer ist, dass man sich gut ausruhen kann. Ein Nachteil ist, dass es im Sommer voll ist. Ich selbst fahre lieber in die Berge, weil ich gern wandere. Und du?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Ich fahre auch gern in die Berge.",
   "p": 1.2,
   "r": "-10%"
  }
 ]
