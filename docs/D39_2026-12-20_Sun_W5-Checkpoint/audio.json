 "sprechen_modell.mp3": [
  {
   "v": "de-DE-KatjaNeural",
   "t": "Guten Tag! Ich heiße Manoj und komme aus Indien. Ich arbeite als Softwareentwickler. Letzten Sommer war ich in Österreich, das Wetter war toll. Ich fahre lieber in die Berge als ans Meer. Und Sie? Wohin fahren Sie lieber?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Am Wochenende kommt unser Besuch. Wir könnten am Samstag in die Altstadt gehen. Was hältst du davon?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Gute Idee. Wann treffen wir uns?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Um elf Uhr am Bahnhof.",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Einverstanden. Ich finde, dass wir danach ein Museum besuchen sollten, weil es regnen soll.",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Ja, das ist besser als ein Spaziergang. Ich reserviere am Abend einen Tisch im Restaurant.",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Gut, und ich kaufe die Karten für das Museum.",
   "p": 1.2,
   "r": "-10%"
  },
  {
