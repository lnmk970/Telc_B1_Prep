 "sprechen_modell.mp3": [
  {
   "v": "de-DE-KatjaNeural",
   "t": "Guten Tag! Ich heiße Manoj und komme aus Indien. In meiner Freizeit sehe ich gern Filme und telefoniere mit meiner Familie. Ich nutze soziale Medien fast jeden Tag, aber nur eine halbe Stunde. Und du? Wie verbringst du deine Freizeit, und welche Medien nutzt du am meisten?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Ich sehe in meiner Freizeit gern Serien und treibe Sport.",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Guten Tag! Ich möchte heute über das Thema „Soziale Medien: Vorteile und Nachteile“ sprechen, weil fast alle Menschen sie nutzen. Ich selbst benutze sie jeden Tag, vor allem, um mit meiner Familie in Indien in Kontakt zu bleiben. In Indien nutzen sehr viele junge Leute soziale Medien, und auch viele Firmen machen dort Werbung. Ein Vorteil ist, dass man schnell Neuigkeiten bekommt und Freunde in der ganzen Welt hat. Ein Nachteil ist, dass man viel Zeit verliert und die Privatsphäre nicht immer geschützt ist. Meiner Meinung nach sind soziale Medien nützlich, wenn man sie bewusst und nicht zu lange benutzt. Vielen Dank für Ihre Aufmerksamkeit.",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Danke für den Vortrag. Wie lange benutzt du am Tag dein Handy?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Etwa eine Stunde, meistens am Abend.",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Hallo Tim! Unsere Kollegin Anna hat nächste Woche Geburtstag. Wir wollen eine kleine Feier für sie organisieren. Wann sollen wir das machen?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Ich schlage vor, dass wir am Freitag in der Mittagspause feiern. Was hältst du davon?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Gute Idee, da sind fast alle im Büro. Und wo feiern wir? Im Büro oder in einem Restaurant?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Ich würde den Besprechungsraum vorschlagen, das ist günstiger. Ich kann ihn reservieren.",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Einverstanden. Wer kümmert sich um das Essen? Wir könnten Kuchen und Brötchen mitbringen.",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Ich backe einen Kuchen, wenn du Getränke besorgst.",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Das passt mir gut. Und was schenken wir ihr? Sie liest gern, vielleicht einen Gutschein für die Buchhandlung?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-ConradNeural",
   "t": "Prima. Wir sammeln von jedem fünf Euro. Haben wir alles besprochen?",
   "p": 1.2,
   "r": "-10%"
  },
  {
   "v": "de-DE-KatjaNeural",
   "t": "Ich glaube schon. Dann machen wir das so.",
   "p": 1.2,
   "r": "-10%"
  }
 ]
